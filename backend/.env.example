# ── Spendora Backend — Required Environment Variables ──────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# PostgreSQL connection string (asyncpg driver)
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/spendora

# Budget near-limit threshold (0.0 – 1.0). Default: 0.80 (80%)
BUDGET_NEAR_LIMIT_THRESHOLD=0.80
