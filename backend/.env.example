# ==============================================================================
#  Spendora Backend — Environment Configuration (.env.example)
# ==============================================================================
#  INSTRUCTIONS:
#  1. Copy this file to .env:  cp .env.example .env
#  2. Fill in your actual secrets and configuration values.
#  3. NEVER commit your real .env file to GitHub or version control!
# ==============================================================================

# ── 1. Database Configuration ────────────────────────────────────────────────
# PostgreSQL connection string using the asyncpg driver (SQLAlchemy 2.0 async).
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
# For Supabase Session Pooler: use port 5432 with your Supabase pooler host.
DATABASE_URL=postgresql+asyncpg://postgres:your_db_password@localhost:5432/spendora

# Budget near-limit alert threshold as a decimal (0.0 to 1.0).
# 0.80 means a visual warning is triggered when 80% of a budget period is spent.
BUDGET_NEAR_LIMIT_THRESHOLD=0.80


# ── 2. Authentication & Security ─────────────────────────────────────────────
# Cryptographic secret key used to sign and verify HMAC-SHA256 JWT access tokens.
# Generate a new 64-character random key in terminal:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_64_character_hex_secret_key_change_in_production

# JWT algorithm (HS256 is the industry standard for HMAC signing).
JWT_ALGORITHM=HS256

# How long an access token stays valid before needing a silent refresh (in minutes).
ACCESS_TOKEN_EXPIRE_MINUTES=15

# How long a refresh token stays valid in the database (in days).
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google OAuth 2.0 Web Client ID obtained from Google Cloud Console.
# Used by the backend to verify Google ID tokens passed by the frontend.
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# URL of your frontend application.
# Used for CORS whitelist, cookie SameSite delivery, and password reset email links.
# Local development: http://localhost:3000
# Production on Vercel: https://spendora-py.vercel.app
FRONTEND_URL=http://localhost:3000

# Set to "true" in production (HTTPS) so session cookies are only transmitted over SSL.
# Keep "false" during localhost development over plain HTTP.
COOKIE_SECURE=false

# SameSite policy for the refresh token cookie ("lax" or "none").
# Use "lax" for standard same-origin or localhost, or "none" with COOKIE_SECURE=true for cross-origin.
COOKIE_SAMESITE=lax


# ── 3. Email Provider Configuration (100% Environment-Driven) ────────────────
# Spendora supports two email delivery modes without modifying any application code:
# Mode A (Recommended for Production): HTTP REST API Provider (Resend, SendGrid, etc.)
# Mode B (Fallback / Local): Standard SMTP (Gmail SMTP, custom relays)

# ── Mode A: HTTP REST API Provider (Resend) ──────────────────────────────────
# The HTTPS endpoint of your email provider's REST API.
# • For Resend: https://api.resend.com/emails
# • For SendGrid: https://api.sendgrid.com/v3/mail/send
# If this is set along with EMAIL_API_KEY, Spendora will automatically use it.
# Leave blank to fall back to standard SMTP below.
EMAIL_API_URL=https://api.resend.com/emails

# The secret API key provided by your email service.
# For Resend, create one in https://resend.com/api-keys (starts with "re_...").
EMAIL_API_KEY=re_your_resend_api_key_here

# The sender address shown in user inboxes.
# If using Resend sandbox without a custom domain: Spendora <onboarding@resend.dev>
# If using a verified custom domain: Spendora <support@yourdomain.com>
EMAIL_FROM=Spendora <onboarding@resend.dev>

# Default display name for emails dispatched by Spendora.
EMAIL_FROM_NAME=Spendora


# ── Mode B: Standard SMTP Configuration (Fallback / Localhost) ───────────────
# Used when EMAIL_API_URL is empty (e.g. testing with Gmail SMTP locally).
# SMTP host (e.g. smtp.gmail.com)
SMTP_HOST=smtp.gmail.com

# SMTP port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# Your Gmail address used to authenticate
SMTP_USER=your_email@gmail.com

# 16-character Google App Password (generated in Google Account Security -> App Passwords)
SMTP_PASSWORD=your_16_character_google_app_password

# Sender email address for SMTP mode
SMTP_FROM_EMAIL=your_email@gmail.com

# Sender display name for SMTP mode
SMTP_FROM_NAME=Spendora

# Enable STARTTLS encryption (recommended for port 587)
SMTP_TLS=true


# ==============================================================================
# 5. AI Intelligence & Recommendations (100% Environment-Driven & Swappable)
# ==============================================================================
# Spendora uses an extensible, provider-agnostic AI engine that works across
# Google Gemini, OpenAI, Anthropic Claude, Groq, OpenRouter, or Ollama.
# Simply specify your AI_PROVIDER and API key below.
#
# Supported AI_PROVIDER values: "gemini" | "openai" | "anthropic" | "groq" | "openrouter" | "ollama"
AI_PROVIDER=gemini

# Generic AI key (takes precedence if set)
# AI_API_KEY=your_ai_api_key_here

# ── Provider Option 1: Google Gemini (Recommended — 100% Free Tier) ───────────
# Get your free key at: https://aistudio.google.com/app/apikey
# Free tier offers 15 Requests/Min, 1,500 Requests/Day (No credit card needed).
# Default model if empty: "gemini-1.5-flash"
GEMINI_API_KEY=your_google_gemini_api_key_here
# AI_MODEL=gemini-1.5-flash

# ── Provider Option 2: OpenAI (ChatGPT) ────────────────────────────────────────
# Get your key at: https://platform.openai.com/api-keys
# Default model if empty: "gpt-4o-mini"
# OPENAI_API_KEY=sk-your_openai_api_key_here
# AI_MODEL=gpt-4o-mini

# ── Provider Option 3: Anthropic (Claude) ──────────────────────────────────────
# Get your key at: https://console.anthropic.com/
# Default model if empty: "claude-3-5-sonnet-20241022"
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here
# AI_MODEL=claude-3-5-sonnet-20241022

# ── Provider Option 4: Groq (Ultra-Fast Llama Models) ──────────────────────────
# Get your free key at: https://console.groq.com/keys
# Default model if empty: "llama-3.3-70b-versatile"
# GROQ_API_KEY=gsk_your_groq_api_key_here
# AI_MODEL=llama-3.3-70b-versatile

# ── Provider Option 5: Custom OpenAI-Compatible Base URL (Ollama / Local / Proxy)
# AI_BASE_URL=http://localhost:11434/v1

