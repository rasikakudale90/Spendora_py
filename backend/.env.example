# ── Spendora Backend — Required Environment Variables ──────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# PostgreSQL connection string (asyncpg driver)
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/spendora

# Budget near-limit threshold (0.0 – 1.0). Default: 0.80 (80%)
BUDGET_NEAR_LIMIT_THRESHOLD=0.80

# ── Authentication & Security ─────────────────────────────────
# Secret key used to sign JWT access tokens (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=your_jwt_secret_key_minimum_32_characters_long

# JWT algorithm (default: HS256)
JWT_ALGORITHM=HS256

# Access token expiration in minutes (default: 15)
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token expiration in days (default: 30)
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google OAuth 2.0 Client ID (for Google Sign-In backend verification)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Frontend origin URL for CORS and cookie delivery
FRONTEND_URL=http://localhost:3000

# Set to true in production over HTTPS so cookies are marked Secure
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
